<?xml version="1.0" encoding="utf-8"?>
<!--
    The themed-icon layer. Android 13 and up tints this one shape with the wallpaper's palette, so
    it cannot use colour to separate anything: the same two cards are redrawn as one filled card
    with its bars knocked out by an even-odd fill, and the card behind it reduced to an outline
    that shows only where it escapes the one in front.

    Geometry identical to ic_launcher_foreground, including the safe circle of radius 33.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">
        <path
            android:pathData="M40,32 L72,32 A4,4 0 0,1 76,36 L76,56 A4,4 0 0,1 72,60 L40,60 A4,4 0 0,1 36,56 L36,36 A4,4 0 0,1 40,32 Z"
            android:strokeColor="#FF000000"
            android:strokeWidth="4" />
    </group>

    <!-- One path, three subpaths. Even-odd is what turns the two bars into holes in the card
         rather than shapes on top of it, which is the only way to draw them when everything here
         ends up the same colour. -->
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M36,48 L68,48 A4,4 0 0,1 72,52 L72,72 A4,4 0 0,1 68,76 L36,76 A4,4 0 0,1 32,72 L32,52 A4,4 0 0,1 36,48 Z M40,56 L62,56 A2,2 0 0,1 62,60 L40,60 A2,2 0 0,1 40,56 Z M40,64 L54,64 A2,2 0 0,1 54,68 L40,68 A2,2 0 0,1 40,64 Z" />

</vector>
