<?xml version="1.0" encoding="utf-8"?>
<!--
    A card outline with a plus in it: nothing here yet, and writing one is what to do about it.

    The canvas draws the outline dashed. A VectorDrawable has no dash support - stroke-dasharray
    has no android: equivalent, and faking it means splitting one rounded rectangle into a dozen
    sub-paths that then have to be re-derived by hand if the shape ever changes. The plus is what
    carries the meaning; the dashes were emphasis on top of it, so the outline is solid here.

    Untinted: the view that draws it tints it from the theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M6.4,6.4 H17.6 A3.2,3.2 0 0 1 20.8,9.6 V15.6 A3.2,3.2 0 0 1 17.6,18.8 H6.4 A3.2,3.2 0 0 1 3.2,15.6 V9.6 A3.2,3.2 0 0 1 6.4,6.4 Z"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M12,10.4 V14.8"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <path
        android:pathData="M9.8,12.6 H14.2"
        android:strokeColor="#FF000000"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

</vector>
