<?xml version="1.0" encoding="utf-8"?>
<resources>

    <string name="app_name">Interview Flashcards</string>

    <string name="nav_study">Study</string>
    <string name="nav_cards">Cards</string>
    <string name="nav_stats">Stats</string>

    <string name="action_sync_now">Sync now</string>
    <string name="sync_queued">Syncing…</string>

    <string name="nav_sign_in">Sign in</string>
    <string name="auth_title">Sign in</string>
    <string name="auth_passphrase">Passphrase</string>
    <string name="auth_sign_in">Sign in</string>
    <string name="auth_sign_out">Sign out</string>

    <!-- Three explanations for one screen, because a person arrives at it in three different
         situations and only one of them is their own doing. -->
    <string name="auth_explanation">Your passphrase gets a token from the server so this device can sync. It is never stored on the device — only the token is.</string>
    <!-- The one that matters. Nothing they did ended the session, and nothing else in the app
         would tell them: the queue simply stops draining. -->
    <string name="auth_expired">Your session ended, so syncing has stopped. Anything you have studied since is still saved here and will be sent once you sign in.</string>
    <string name="auth_signed_in">This device is signed in. Signing in again replaces the current session.</string>
    <!-- The whole point of not gating the app behind this screen, said out loud so backing out
         of it reads as a choice rather than a retreat. -->
    <string name="auth_offline_note">You do not have to sign in to use the app. Studying, writing and editing all work from this device; only syncing needs a connection to the server.</string>

    <!-- Failures a person can act on differently: retype it, wait a few minutes, wait for
         someone to configure the server, turn the radio on, wait for the server to wake, or try
         later. A single "sign-in failed" would answer none of them — and the server one
         especially, because no amount of retyping will ever fix it. -->
    <string name="auth_error_empty">Type your passphrase first.</string>
    <string name="auth_error_refused">That passphrase was not accepted.</string>
    <!-- Deliberately vague about how long. The server counts failures over a rolling fifteen
         minutes, so there is no single moment to name, and naming one would be wrong. -->
    <string name="auth_error_too_many">Too many attempts. Wait a few minutes and try again.</string>
    <!-- Not a wrong passphrase and not a passing outage: the server has no passphrase set, so
         nothing typed here will work until somebody configures one. -->
    <string name="auth_error_unavailable">Signing in is not set up on the server yet. Nothing you type here will work until it is.</string>
    <string name="auth_error_offline">No connection. Signing in needs the internet.</string>
    <string name="auth_error_server">The server could not sign you in. Try again later.</string>
    <!-- Not "offline": the device reached the server and the server was slow to answer. A
         Render instance idle long enough to be put to sleep takes about two minutes to wake,
         longer than this client waits, and that used to be reported as a missing connection on
         a device that was online the whole time. -->
    <string name="auth_error_slow">The server is taking a while to answer. If it has been idle it can need a couple of minutes to wake up — try again shortly.</string>
    <!-- The exchange started and went wrong some other way, such as an answer with nothing in
         it. Neither the device's connection nor anything the person typed. -->
    <string name="auth_error_broken">Something went wrong talking to the server. Try again.</string>
    <!-- Shown under the progress bar once a sign-in has gone five seconds unanswered. Not an
         error: the attempt is still running and may well succeed. It is there because a server
         put to sleep takes about two minutes to answer, and a progress bar alone for that long
         reads as an app that has frozen. -->
    <string name="auth_waking">Waking up the server — this can take a couple of minutes on first use.</string>

    <!-- The strip above the content. It is the only place a dead session surfaces on its own —
         a background sync cannot report one through WorkManager, so this reads the store. -->
    <string name="auth_banner_expired">Session ended — sync is paused. Tap to sign in.</string>
    <string name="auth_banner_never">Not signed in — sync is paused. Tap to sign in.</string>

    <!-- The unlock gate. Off unless somebody turns it on, which is why the menu item says what
         it will do rather than naming a feature. -->
    <string name="lock_require">Require unlock</string>
    <string name="lock_title">Flashcards is locked</string>
    <string name="lock_subtitle">Unlock to see your cards.</string>
    <string name="lock_unlock">Unlock</string>
    <!-- After a prompt that closed without succeeding. Deliberately not "authentication failed":
         the commonest way to get here is dismissing the dialog on purpose, which is not a
         failure and should not be described as one. -->
    <string name="lock_retry_message">Still locked. Unlock to see your cards.</string>
    <!-- Shown when the setting is switched on for the first time on a device that cannot satisfy
         it. Naming both ways out matters: a fingerprint is the obvious one, but a screen lock is
         the one that always works, and somebody with neither would otherwise be told only that
         it is unavailable. -->
    <string name="lock_unavailable">This device has no fingerprint, face unlock or screen lock set up, so there is nothing to unlock with.</string>
    <!-- Said once, when it is turned on, because the limit is easy to overestimate and nothing
         else in the app will ever mention it. -->
    <string name="lock_enabled_note">The app will ask before showing your cards. This does not encrypt anything on the device.</string>

    <!-- Bare numbers with labels beneath them rather than "12 cards". Three figures side by
         side are read by comparing them, and a unit repeated under each one is three words in the
         way of that. -->
    <string name="stats_due_label">Due today</string>
    <string name="stats_reviewed_label">Reviewed today</string>
    <string name="stats_total_label">In circulation</string>

    <string name="stats_streak_title">Streak</string>
    <plurals name="stats_streak_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <string name="stats_streak_as_of">Last fetched %1$s</string>
    <!-- Its own sentence rather than a relative span, because every span short enough to land
         here rounds to a zero: "0 minutes ago" for a sync that has just finished, and "0 seconds
         ago" if the resolution is dropped to seconds. A figure fetched moments ago is as current
         as this screen can claim, and that is what it should say. -->
    <string name="stats_streak_as_of_now">Last fetched just now</string>
    <!-- Shown instead of the number, never beside a zero. The streak is worked out on the server
         because its rule needs the whole review history; telling somebody thirty days into a run
         that they are on nothing is the worst thing this screen could do. -->
    <string name="stats_streak_unknown">Not fetched yet. Run a sync to get it from the server.</string>

    <string name="stats_by_topic">By topic</string>
    <!-- A topic row became tappable, so it needs to say where it goes. The bar and the counts
         beside it are decoration to a screen reader; this is the row. -->
    <string name="stats_topic_open">Show cards in %1$s</string>
    <!-- The quantity is the topic total, not the due count: "of 1 card" is the half of this
         sentence that inflects. -->
    <plurals name="stats_topic_counts">
        <item quantity="one">%1$d due of %2$d card</item>
        <item quantity="other">%1$d due of %2$d cards</item>
    </plurals>
    <string name="stats_no_topics">No topics yet. Run a sync to fetch them.</string>
    <!-- The other empty state, after a sync has come back. "Run a sync" is then advice that has
         already been taken and changed nothing, so this says where topics actually come from:
         nothing in the app creates one yet. -->
    <string name="stats_no_topics_on_server">The server has no topics yet. Topics can\'t be created in the app yet — add one on the server, then sync.</string>

    <string name="study_show_answer">Show answer</string>

    <!-- Optional, and said so in the hint rather than in a label beside it: the field is the
         only thing on the screen that can be skipped, and a hint is where somebody deciding
         whether to type is already looking. -->
    <string name="study_attempt_hint">Type your answer — optional</string>
    <!-- Nothing grades this. Saying so is what stops the field reading as a test inside a test,
         and saying what it is for is what makes it worth typing into. -->
    <string name="study_attempt_note">Not graded. It stays on screen so you can compare.</string>
    <!-- Drawn in capitals by the view, not written in them here. A translation may have no
         capitals to draw, and one written in them cannot be lower-cased back. -->
    <string name="study_you_wrote">You wrote</string>

    <!-- 1 and 2 are below Sm2Scheduler.LAPSE_THRESHOLD and send the card back to the start of
         the ladder; 3 to 5 advance it. The wording is meant to make that boundary legible without
         a legend, which a bare 1-to-5 ramp would not. -->
    <string name="study_confidence_1">No idea</string>
    <string name="study_confidence_2">Wrong</string>
    <string name="study_confidence_3">Shaky</string>
    <string name="study_confidence_4">Good</string>
    <string name="study_confidence_5">Instant</string>

    <plurals name="study_due_today">
        <item quantity="one">%1$d card due</item>
        <item quantity="other">%1$d cards due</item>
    </plurals>

    <!-- Each empty state is a heading and a sentence rather than one string, because the screen
         draws them as two views at two sizes. Split here rather than at a full stop in code,
         because a translation is not obliged to have one or to put it in the same place.

         The second pair is deliberately not a rewording of the first. A fresh install has
         finished nothing, and the real reason its queue is empty is that no sync has run yet. -->
    <string name="study_caught_up_title">All caught up.</string>
    <string name="study_caught_up_body">Nothing due today.</string>
    <string name="study_no_cards_title">No cards here yet.</string>
    <string name="study_no_cards_body">Run a sync to fetch them.</string>
    <!-- Shown on a row only when there is something to say. Most rows are synced and say
         nothing at all; a badge on every one of them would be noise. -->
    <string name="cards_unsent">Unsent</string>
    <string name="cards_rejected">Rejected</string>
    <string name="cards_no_topic">No topic</string>

    <!-- Two states, not one sentence reworded. An empty deck is a sync that has not run; an
         empty topic is a topic nothing has been written for yet. They are answered by different
         actions, so they are different strings and the second names the topic. -->
    <string name="cards_empty_title">No cards yet.</string>
    <string name="cards_empty_body">Run a sync to fetch them, or write one.</string>
    <string name="cards_empty_topic_title">No cards in %1$s yet.</string>
    <string name="cards_empty_topic_body">Write one, or generate a batch for this topic.</string>

    <!-- The chip that clears the filter. Named rather than drawn as an icon, because it sits in
         a row of topic names and has to read as one of them. -->
    <string name="cards_filter_all">All</string>
    <string name="cards_new">New card</string>

    <string name="editor_new">New card</string>
    <string name="editor_edit">Edit card</string>
    <!-- Neither "New card" nor "Edit card": the text came from somewhere, and saving
         adds it to the deck rather than changing something already in it. -->
    <string name="editor_generated">Add generated card</string>
    <!-- Shown only when the editor is holding a candidate. It answers the question that screen
         raises and no other one does: whether this is already a card. It is not, until saving. -->
    <string name="editor_generated_note">Generated, not saved yet. Correct anything that is wrong and it is added as your own card.</string>
    <string name="editor_topic">Topic</string>
    <string name="editor_front">Question</string>
    <string name="editor_back">Answer</string>
    <string name="editor_save">Save</string>
    <string name="editor_archive">Archive</string>
    <string name="editor_cancel">Cancel</string>
    <string name="editor_required">This cannot be empty</string>

    <!-- The server's own detail string, shown as it arrived. A generic "could not sync" would
         drop the only part somebody can act on, and the backend writes these for a caller. -->
    <string name="editor_rejected">The server refused this card: %1$s

Fix it and save to try again.</string>

    <string name="editor_no_topics">No topics yet. Run a sync before writing a card.</string>
    <!-- See stats_no_topics_on_server: a sync has run and the server had nothing to send. -->
    <string name="editor_no_topics_on_server">The server has no topics yet. Topics can\'t be created in the app yet — add one on the server, then sync.</string>
    <string name="editor_gone">That card is no longer here.</string>

    <string name="editor_archive_title">Archive this card?</string>
    <!-- Two different warnings, because archiving is two different things. -->
    <string name="editor_archive_synced">It stops appearing in your queue. The server keeps its history.</string>
    <string name="editor_archive_local">This card has never reached the server, so archiving deletes it here. Nothing can bring it back.</string>

    <string name="generate_title">Generate cards</string>
    <string name="generate_topic">Topic</string>
    <string name="generate_focus">Focus (optional)</string>
    <string name="generate_count">How many</string>
    <string name="generate_go">Generate</string>
    <!-- Failures a person can tell apart and act on differently: wait, change the focus, turn
         the radio on, sync, or stop trying and go and fix the server. A single "generation
         failed" would answer none of them, and the last one especially: advising a retry for a
         wrong key invites it forever. -->
    <string name="generate_error_busy">The card generator is busy. Try again shortly.</string>
    <string name="generate_error_refused">The generator had nothing to add for that. Try a different focus.</string>
    <string name="generate_error_offline">No connection. Generating needs the internet.</string>
    <string name="generate_error_misconfigured">Card generation is not set up correctly on the server. Retrying will not help.</string>
    <!-- A fifth failure, and the reason it is not folded into "busy": that one says try again
         shortly, and shortly is wrong. The daily allowance exists so generating cannot run up an
         unbounded bill, and it comes back at midnight rather than in a moment. Saying tomorrow is
         what stops somebody retrying all evening. -->
    <string name="generate_error_limit">That is all the card generation for today. The limit resets tomorrow.</string>
    <!-- Not "busy" and not "offline": the server itself was slow to answer, which on Render is
         usually an idle instance waking up. See auth_error_slow. -->
    <string name="generate_error_slow">The server is taking a while to answer. If it has been idle it can need a couple of minutes to wake up — try generating again shortly.</string>
    <!-- A 404: this device holds a topic the server no longer has. A sync fixes it, and the
         "not set up correctly" this used to fall through to would have sent somebody to look for
         a server fault instead. -->
    <string name="generate_error_missing_topic">That topic isn\'t on the server any more. Sync to refresh your topics, then try again.</string>
    <string name="generate_error_broken">Something went wrong talking to the server. Try again.</string>
    <plurals name="generate_done">
        <item quantity="one">%d card ready to review</item>
        <item quantity="other">%d cards ready to review</item>
    </plurals>

    <!-- Both quantities read the same. The plural exists so the number is formatted by the
         platform rather than concatenated, which is what makes it translatable at all. -->
    <plurals name="candidate_header">
        <item quantity="one">%d generated — review before saving</item>
        <item quantity="other">%d generated — review before saving</item>
    </plurals>
    <string name="candidate_accept">Add</string>
    <!-- The row is tappable and always was, which works and is invisible. This is the same way
         in, said out loud. -->
    <string name="candidate_edit">Edit</string>
    <string name="candidate_discard">Discard</string>
    <string name="candidate_discard_all">Discard all</string>

</resources>
