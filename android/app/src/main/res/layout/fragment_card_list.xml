<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!--
            Pinned rather than scrolling with the list. This is what decides what you are looking
            at, so it has to be reachable from anywhere in the list and not only from the top.

            Horizontally scrolling because the number of topics is the user's business, not the
            screen's, and wrapping them onto a second line would move the list down by a row
            every time a topic was added.
        -->
        <HorizontalScrollView
            android:id="@+id/cards_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cards_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cards_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="96dp"
            tools:listitem="@layout/item_card" />

        <!--
            Two sentences and a tile, not one line of text. Which pair goes in here depends on the
            filter: an empty deck is a sync that has not run, an empty topic is a topic nothing
            has been written for, and they are answered by different actions.
        -->
        <LinearLayout
            android:id="@+id/cards_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="34dp"
            android:paddingBottom="60dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cards_empty_tile"
                android:layout_width="92dp"
                android:layout_height="92dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_cards"
                    app:tint="?attr/colorPrimary" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/cards_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="-0.013"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                tools:text="No cards yet." />

            <TextView
                android:id="@+id/cards_empty_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                tools:text="Run a sync to fetch them, or write one." />

        </LinearLayout>

    </LinearLayout>

    <!--
        Last in the file, so it draws above the empty message rather than under it. The empty
        message fills the frame, and an empty list is exactly when writing a card is the only
        thing left to do.

        A squircle rather than a circle: it is the one control on this screen that is not a row
        or a chip, and at 21dp it belongs to the same family of corners as everything else.

        fabCustomSize repeats the 60dp on purpose, and is not redundant with the layout size. A
        FloatingActionButton positions its icon against its own fabSize - NORMAL, 56dp, by
        default - rather than against the bounds it was measured at, so a layout_width the FAB
        has not been told about leaves the icon centred in a 56dp box in the corner of a 60dp
        view: 2dp up and 2dp left of where it belongs. Visible, and invisible to every test.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/cards_new"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/cards_new"
        android:src="@drawable/ic_add"
        app:fabCustomSize="60dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Flashcards.Fab" />

</FrameLayout>
