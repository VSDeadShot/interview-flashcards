<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cards_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        tools:listitem="@layout/item_card" />

    <TextView
        android:id="@+id/cards_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/cards_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <!-- Last in the file, so it draws above the empty message rather than under it. The empty
         message fills the frame, and an empty list is exactly when writing a card is the only
         thing left to do. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/cards_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/cards_new"
        android:src="@drawable/ic_add" />

</FrameLayout>
