<?xml version="1.0" encoding="utf-8"?>
<!--
    No background here. The window carries it, so the toolbar, the container and the bar all sit
    on one ground and a fragment that draws nothing shows that ground rather than black.
-->
<!--
    A merge, not a FrameLayout. Two children are needed rather than one — the column that is the
    screen, and the lock overlay stacked on top of it, which has to cover the toolbar and the
    bottom bar and so cannot live inside the column. The activity's own content view is already
    a FrameLayout, so wrapping these in another one would add a level that stacks them exactly
    the way the existing one already would; merge puts both straight into it.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        fitsSystemWindows because edge-to-edge is enforced from Android 15 for targetSdk 35 and
        up: the window extends under the system bars and an app is expected to inset its own
        content. BottomNavigationView already consumes the bottom inset itself, so only the top
        was wrong - the toolbar drew over the status bar clock. Neither the build nor the test
        suite reports it, because Robolectric composes no system bars; it was found by running
        the app on an emulator and looking at the screen.

        Flat against the page, and it stays flat: liftOnScroll would put a tinted bar over the
        title the moment a list moved under it, which is the one thing the design does not do -
        the separation between the bar and the content comes from the content being inset.
    -->
    <com.google.android.material.appbar.AppBarLayout
        style="@style/Widget.Flashcards.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Flashcards.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!--
        Where a dead session surfaces. It has to be somewhere: a background sync cannot report a
        rejected credential through WorkInfo — periodic work stores neither result's output data
        — so the only thing that can reach a screen is the token store the authenticator wrote
        its reason into, and this is what reads it.

        A strip above the content rather than a dialog or a snackbar. What it reports is a
        standing condition, not an event: the outbox is not draining and will not until somebody
        signs in, so a message that dismisses itself after four seconds would be the wrong shape
        for it. Gone by default, and gone the moment there is a session again.
    -->
    <TextView
        android:id="@+id/auth_banner"
        style="@style/Widget.Flashcards.Banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:text="Session ended — sync is paused. Tap to sign in."
        tools:visibility="visible" />

    <!--
        A FragmentContainerView rather than a FrameLayout: it is what NavHostFragment is
        documented to be inflated into, and it defers adding the fragment until the container is
        attached, which is what keeps the graph's start destination restored correctly across a
        configuration change.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!--
        The one surface in the app lighter than the page rather than level with it, which is what
        makes the bar read as sitting over the content instead of behind it.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        style="@style/Widget.Flashcards.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />

</LinearLayout>

    <!--
        The gate. Opaque and full-bleed, so nothing behind it is legible while it is up — a
        translucent scrim would leave the question on the study screen readable, which is most of
        what there is to read.

        clickable and focusable are load-bearing rather than tidy: without them touches fall
        through to the toolbar and the bottom bar underneath, and the lock becomes a picture of a
        lock. It is also the reason this is a sibling of the whole column rather than a view
        inside it.

        Not a navigation destination. A destination can be dismissed with the back button, which
        is the one thing a gate must not do.
    -->
    <LinearLayout
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textAppearance="@style/TextAppearance.Flashcards.ScreenTitle" />

        <!--
            Says why the app is not showing, and it is set from code rather than fixed here: a
            first prompt and a refused one are different situations, and only the second needs to
            explain itself.
        -->
        <TextView
            android:id="@+id/lock_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/lock_subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!--
            The way back after a cancelled or failed prompt. Without it the overlay is a dead end
            whenever the system dialog closes for any reason other than success, and the only way
            out of the app would be to leave it.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/lock_retry"
            style="@style/Widget.Flashcards.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lock_unlock" />

    </LinearLayout>

</merge>
