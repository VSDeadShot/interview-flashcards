<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        fitsSystemWindows because edge-to-edge is enforced from Android 15 for targetSdk 35 and
        up: the window extends under the system bars and an app is expected to inset its own
        content. BottomNavigationView already consumes the bottom inset itself, so only the top
        was wrong - the toolbar drew over the status bar clock. Neither the build nor the test
        suite reports it, because Robolectric composes no system bars; it was found by running
        the app on an emulator and looking at the screen.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <!--
        A FragmentContainerView rather than a FrameLayout: it is what NavHostFragment is
        documented to be inflated into, and it defers adding the fragment until the container is
        attached, which is what keeps the graph's start destination restored correctly across a
        configuration change.
    -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
