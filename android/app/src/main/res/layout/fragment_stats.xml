<?xml version="1.0" encoding="utf-8"?>
<!--
    The topic breakdown is inflated into a plain container rather than drawn by a RecyclerView.
    The rows have to scroll with the figures above them, and a RecyclerView nested in a scrolling
    parent has to be told to stop recycling before it will lay out at all — so the machinery would
    be paid for and then switched off. The list is also bounded by the number of topics, which is
    a handful of subject areas, not a feed.

    That container is a card, which is what gives the rows their one rounded surface: the card
    clips them to its corners, so no row has to know it is the first or the last.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_figures"
            style="@style/Widget.Flashcards.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="22dp">

                <!--
                    Due first and in the accent colour, because it is the only figure on this
                    screen that asks for something to be done. The other two are context for it.
                -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stats_due_today"
                        style="@style/TextAppearance.Flashcards.Figure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorPrimary"
                        tools:text="4" />

                    <TextView
                        style="@style/TextAppearance.Flashcards.FigureLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stats_due_label" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stats_reviewed_today"
                        style="@style/TextAppearance.Flashcards.Figure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="3" />

                    <TextView
                        style="@style/TextAppearance.Flashcards.FigureLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stats_reviewed_label" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stats_total_cards"
                        style="@style/TextAppearance.Flashcards.Figure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="9" />

                    <TextView
                        style="@style/TextAppearance.Flashcards.FigureLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stats_total_label" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!--
            The streak is the one figure on this screen the client cannot work out, so it is the
            only one that can be absent. The number and the sentence below it are separate views
            precisely so the number can be hidden: an absent streak has to read as "we have not
            been told", never as a zero.
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/stats_streak"
            style="@style/Widget.Flashcards.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="20dp">

                <TextView
                    style="@style/TextAppearance.Flashcards.FigureLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_streak_title" />

                <TextView
                    android:id="@+id/stats_streak_value"
                    style="@style/TextAppearance.Flashcards.Figure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="6 days" />

                <TextView
                    android:id="@+id/stats_streak_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="Last fetched 4 minutes ago" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/stats_by_topic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:paddingHorizontal="6dp"
                android:paddingBottom="10dp"
                android:text="@string/stats_by_topic"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stats_no_topics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="6dp"
                android:text="@string/stats_no_topics"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stats_topics_card"
                style="@style/Widget.Flashcards.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/stats_topics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_topic_rows"
                    android:orientation="vertical"
                    android:showDividers="middle" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
