<?xml version="1.0" encoding="utf-8"?>
<!--
    The band's own row rather than a header view outside the list. It scrolls with the candidates
    it counts; a fixed header would sit over saved cards long after the band it describes had
    scrolled away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/candidate_header_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/candidate_discard_all"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/candidate_discard_all" />

</LinearLayout>
