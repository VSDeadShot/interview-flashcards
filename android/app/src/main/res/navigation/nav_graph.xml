<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/studyFragment">

    <!-- Three peers, all top level, so none of them shows an up button. The bottom bar is how
         somebody moves between them, and switching tab carries nothing. The one action between
         two of them is a different thing: a drill-in from a stats row into the cards that row
         counts, which is why it is the only one that carries an argument. -->

    <fragment
        android:id="@+id/studyFragment"
        android:name="dev.vsdeadshot.flashcards.ui.study.StudyFragment"
        android:label="@string/nav_study"
        tools:layout="@layout/fragment_study" />

    <fragment
        android:id="@+id/cardListFragment"
        android:name="dev.vsdeadshot.flashcards.ui.cards.CardListFragment"
        android:label="@string/nav_cards"
        tools:layout="@layout/fragment_card_list">

        <!-- Which topic the list is scoped to. 0 means all of them — the same convention cardId
             uses below and for the same reason: local ids run downwards from zero and server ids
             start at 1, so zero is the one value that is never a real id.

             It has a default rather than being required, because the bottom bar navigates here
             with no arguments at all. A required argument would make the tab itself throw. -->
        <argument
            android:name="topicId"
            android:defaultValue="0L"
            app:argType="long" />

        <action
            android:id="@+id/action_cardList_to_cardEditor"
            app:destination="@id/cardEditorFragment" />

    </fragment>

    <!--
        Not in the bottom bar's menu, which is what AppBarConfiguration is built from, so this is
        the one destination that is not top level and shows an up arrow.

        The label is a placeholder NavigationUI fills from the arguments, which is how one
        destination is titled "New card" or "Edit card" without a second destination or the Safe
        Args plugin.
    -->
    <fragment
        android:id="@+id/cardEditorFragment"
        android:name="dev.vsdeadshot.flashcards.ui.cards.CardEditorFragment"
        android:label="{title}"
        tools:layout="@layout/fragment_card_editor">

        <!-- 0 rather than -1 for "a new card": local ids run downwards from zero, so -1 is a
             real card, and server ids start at 1. Zero is the one value that is never an id. -->
        <argument
            android:name="cardId"
            android:defaultValue="0L"
            app:argType="long" />

        <!-- Zero means "not a candidate", the same convention cardId uses and for the same
             reason. The two are never both set: a candidate has no card until it is accepted. -->
        <argument
            android:name="candidateId"
            android:defaultValue="0L"
            app:argType="long" />

        <argument
            android:name="title"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="dev.vsdeadshot.flashcards.ui.stats.StatsFragment"
        android:label="@string/nav_stats"
        tools:layout="@layout/fragment_stats">

        <!--
            Tapping a topic row opens the cards that row counts. This crosses top-level
            destinations, which is the part worth writing down: the bottom bar's checked item
            moves to Cards on its own, because NavigationUI listens for destination changes
            rather than for taps — so the indicator follows without anything here moving it, and
            it cannot end up lit on Stats while the card list is on screen.

            Back returns here rather than to whatever was last on the Cards tab, which is what
            one shared back stack already gives and is the behaviour this drill-in wants.
        -->
        <action
            android:id="@+id/action_stats_to_cardList"
            app:destination="@id/cardListFragment" />

    </fragment>

</navigation>
