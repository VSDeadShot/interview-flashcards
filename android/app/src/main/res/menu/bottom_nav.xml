<?xml version="1.0" encoding="utf-8"?>
<!--
    The item ids are the destination ids from nav_graph.xml, not names of their own. That is what
    NavigationUI.setupWithNavController matches on, so a rename in one file that is not made in
    the other stops the tab working rather than failing to build.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/studyFragment"
        android:icon="@drawable/ic_study"
        android:title="@string/nav_study" />

    <item
        android:id="@+id/cardListFragment"
        android:icon="@drawable/ic_cards"
        android:title="@string/nav_cards" />

    <item
        android:id="@+id/statsFragment"
        android:icon="@drawable/ic_stats"
        android:title="@string/nav_stats" />

</menu>
