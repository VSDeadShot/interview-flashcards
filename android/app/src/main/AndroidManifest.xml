<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission this app needs. Everything it shows comes from its own database;
         the network is for syncing that database, not for reading a screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".FlashcardsApp"
        android:allowBackup="true"
        android:label="Interview Flashcards"
        android:supportsRtl="true" />

</manifest>
